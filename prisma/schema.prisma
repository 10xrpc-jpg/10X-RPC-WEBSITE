// 10X RPC — Prisma schema
// Uses PostgreSQL (Neon) in production. Falls back to SQLite if DATABASE_URL
// starts with "file:". The provider is resolved by postinstall script + the
// build script that runs `prisma generate` with the correct provider.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String   @id @default(cuid())
  discordId     String   @unique
  username      String
  discriminator String?
  avatar        String?
  backgroundUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  rpcConfigs     RpcConfig[]
  gameConfigs    GameConfig[]
  rotatorPresets RotatorPreset[]
  globalConfig   GlobalConfig?
  trial          Trial?
  favoriteGames  FavoriteGame[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Discord OAuth tokens (stored server-side only, never sent to client)
  discordAccessToken    String?
  discordRefreshToken   String?
  discordTokenExpiresAt DateTime?

  // Status & RPC state (completely independent)
  statusEnabled      Boolean   @default(false)
  rpcEnabled         Boolean   @default(false)
  gatewayReady       Boolean   @default(false)
  userStatus         String    @default("online")
  customStatus       String?
  customStatusEmoji  String?
  statusPlatform     String    @default("mobile")
  lastPresenceUpdate DateTime?

  // VR / Meta Quest state
  vrStatusActive     Boolean   @default(false)
  vrSessionToken     String?
  vrMetaAccessToken  String?
  vrMetaRefreshToken String?
  vrMetaTokenExpires DateTime?

  // Smart sleep timer
  sleepTimerActive Boolean   @default(false)
  sleepTimerEndsAt DateTime?

  @@index([userId])
}

model RpcConfig {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String   @default("10X RPC")
  type         String   @default("PLAYING") // PLAYING / STREAMING / LISTENING / WATCHING / COMPETING
  platform     String   @default("desktop") // desktop / xbox / ps4 / ps5 / samsung / ios / android / embedded / meta_quest
  state        String?
  details      String?
  largeImage   String?
  largeText    String?
  smallImage   String?
  smallText    String?
  button1Label String?
  button1Url   String?
  button2Label String?
  button2Url   String?
  partyCurrent Int?
  partyMax     Int?
  partyId      String?
  partySecret  String?
  startMinsAgo Int      @default(0)
  endTotalMins Int?
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model GameConfig {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSlug     String // e.g. "minecraft", "genshin", "gta-v", "custom-4f2a..."
  gameName     String
  enabled      Boolean  @default(false)
  appId        String? // Discord Application ID (custom games with "Add Games") — daemon presents presence as this application
  platform     String   @default("desktop")
  state        String?
  details      String?
  largeImage   String?
  largeText    String?
  smallImage   String?
  smallText    String?
  button1Label String?
  button1Url   String?
  button2Label String?
  button2Url   String?
  partyCurrent Int      @default(1)
  partyMax     Int      @default(5)
  partyId      String?
  partySecret  String?
  startMinsAgo Int      @default(0)
  endTotalMins Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, gameSlug])
  @@index([userId])
}

model RotatorPreset {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji        String?
  text         String
  durationMins Int      @default(5) // how long this status stays before rotating
  order        Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model GlobalConfig {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city                String?
  timezone            String   @default("Asia/Calcutta")
  rotatorEnabled      Boolean  @default(false)
  rotatorIntervalMins Int      @default(5)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Trial {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime @default(now())
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  verifier  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([state])
}

// Cache of images uploaded as Discord application assets (url -> asset key)
// so the RPC daemon can reference user-provided image URLs as native
// Discord assets (gateway presences only render application asset keys).
model DiscordAsset {
  id        String   @id @default(cuid())
  url       String   @unique // source image URL (or local file:// reference)
  key       String   @unique // Discord application asset key (name) sent in activity assets
  assetId   String? // Discord numeric asset id (informational)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// Mirrored copies of user-provided images, served via /api/asset-mirror/[hash].
// Unlike public/asset-mirror static files (which only reach production on a
// redeploy), DB-backed mirrors are live on Vercel IMMEDIATELY — new user images
// resolve without any deploy step.
model MirrorAsset {
  id          String   @id @default(cuid())
  hash        String   @unique // sha1(source URL pathname), 16 hex chars
  contentType String
  bytes       Bytes
  size        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Profile Board → Favorite Game: the user's shortlist of games (starred).
// A favorite references either a catalog preset (slug) or a Discord
// application discovered via the directory search (appId). "Use for Game RPC"
// resolves it to the user's GameConfig (creating the custom game if needed)
// and enables it as the active Gamer RPC.
model FavoriteGame {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // official game/application name
  appId     String? // Discord Application ID (discovered apps)
  slug      String? // catalog slug (preset games, e.g. "minecraft")
  iconUrl   String?
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}
