# ============================================================
# 10X RPC 24/7 node — server configuration (dotenv)
# Rename this file to `.env` on the server (the kit ships it as
# `env.example`; copy → .env, then edit the values below).
# ============================================================

# ── DATABASE (REQUIRED) ─────────────────────────────────────
# Production Postgres. Prefer the UNPOOLED/direct endpoint for the 24/7
# daemon (long-lived connections; pooled endpoints recycle idle sockets).
# Copy BOTH values from the same source the website uses (e.g. the Neon
# dashboard → Connection Strings, or the project owner's password manager).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# ── NODE IDENTITY (REQUIRED) ────────────────────────────────
# Which pillar this node owns. One of: status | rpc | game | all
# (status = custom status + VR badge · rpc = RPC slots + Application RPC ·
#  game = Game RPC). Use `all` on a single-node deployment.
DAEMON_ROLE=rpc

# Human-readable node id used by the pillar-failover lease system.
# Must be UNIQUE across all running nodes (e.g. softhost-1).
DAEMON_NODE_ID=softhost-1

# ── INSTANT SYNC SECRET (REQUIRED) ──────────────────────────
# MUST match the value shown in the website admin dashboard
# (Admin → Settings → Backend Nodes → Instant-sync secret). A mismatch
# means instant syncs are rejected (403) and presence falls back to the
# slower 30-second polling tick.
DAEMON_SYNC_SECRET=PASTE_THE_SECRET_FROM_THE_ADMIN_DASHBOARD

# ── OPTIONAL ────────────────────────────────────────────────
# Internal sync listener port (loopback only). Keep the default unless
# the panel forbids it.
DAEMON_SYNC_PORT=3100
# Heartbeat/watchdog tuning (defaults are fine).
# DAEMON_HEARTBEAT_MAX_AGE_SEC=180
# DAEMON_WATCHDOG_KILL_AFTER_SEC=300
