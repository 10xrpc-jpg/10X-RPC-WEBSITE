# 10X RPC — Environment Configuration Example

# Database:
# For production PostgreSQL (e.g. Neon, Supabase):
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Render API Key (for automated backend management)
RENDER_API_KEY="rnd_your_render_api_key"

# Session encryption secret (min 32 characters, generate with: openssl rand -base64 48)
SESSION_SECRET="your-48-byte-random-session-secret-goes-here"

# App URL (frontend domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Discord Server & Community
DISCORD_SERVER_ID="1549302358926823496"
DISCORD_INVITE_URL="https://discord.gg/jr27qeCZU"

# Discord OAuth2 Application Credentials
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_REDIRECT_URI="http://localhost:3000/auth/callback"
DISCORD_OAUTH_SCOPE="openid identify sdk.social_layer_presence"

# Optional: If deploying split architecture (Vercel frontend + Render backend)
# RENDER_API_URL="https://your-backend.onrender.com"

# Presence backend (24/7 daemon):
#   ORIHOST_DAEMON_URL  — base URL of the 24/7 daemon (owns the gateway session)
#   ORIHOST_SYNC_SECRET — shared secret for instant /sync pushes to that daemon
# ORIHOST_DAEMON_URL="https://your-daemon-host:port"
# ORIHOST_SYNC_SECRET="your-sync-secret"

# Cron/tick endpoint secrets (optional per deployment; when set, the matching
# Bearer is required): KEEP_ALIVE_SECRET, ROTATOR_TICK_SECRET, SLEEP_TIMER_TICK_SECRET
# KEEP_ALIVE_SECRET="your-keep-alive-secret"
# ROTATOR_TICK_SECRET="your-rotator-tick-secret"
# SLEEP_TIMER_TICK_SECRET="your-sleep-timer-tick-secret"

# Comma-separated Discord user IDs with admin access (optional override)
# ADMIN_DISCORD_IDS="123456789012345678"
